PROGRAM main
  VAR
    TOF0 : TOF;
    TOF1 : TOF;
    fill_time_to_count : TIME;
    discharge_time_to_count : TIME;
    only_dis : BOOL;
    only_fill : BOOL;
  END_VAR
  VAR
    Discharge AT %IX100.0 : BOOL := 1;
    I_Fill AT %IX100.1 : BOOL;
    Discharge_valve AT %QX100.0 : BOOL;
    Discharging AT %QX100.1 : BOOL;
    Fill_valve AT %QX100.2 : BOOL;
    Filling AT %QX100.3 : BOOL;
    Timer AT %QW100 : INT;
  END_VAR
  VAR
    _TMP_TIME_TO_INT8073191_ENO : BOOL;
    _TMP_TIME_TO_INT8073191_OUT : INT;
    _TMP_TIME_TO_INT6710441_ENO : BOOL;
    _TMP_TIME_TO_INT6710441_OUT : INT;
  END_VAR

  TOF0(IN := I_Fill, PT := T#8s);
  Fill_valve := TOF0.Q;
  fill_time_to_count := TOF0.ET;
  Filling := TOF0.Q;
  only_dis := TOF0.Q;
  TOF1(IN := NOT(Discharge), PT := T#8s);
  Discharge_valve := TOF1.Q;
  discharge_time_to_count := TOF1.ET;
  Discharging := TOF1.Q;
  only_fill := TOF1.Q;
  _TMP_TIME_TO_INT8073191_OUT := TIME_TO_INT(EN := NOT(only_fill), IN := fill_time_to_count, ENO => _TMP_TIME_TO_INT8073191_ENO);
  IF _TMP_TIME_TO_INT8073191_ENO THEN
      Timer := _TMP_TIME_TO_INT8073191_OUT;
  END_IF;
  _TMP_TIME_TO_INT6710441_OUT := TIME_TO_INT(EN := NOT(only_dis), IN := discharge_time_to_count, ENO => _TMP_TIME_TO_INT6710441_ENO);
  IF _TMP_TIME_TO_INT6710441_ENO THEN
      Timer := _TMP_TIME_TO_INT6710441_OUT;
  END_IF;
END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    TASK task0(INTERVAL := T#20ms,PRIORITY := 1);
    PROGRAM instance0 WITH task0 : main;
  END_RESOURCE
END_CONFIGURATION

